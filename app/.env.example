# Base de données Neon (projet tacos-fox, aws-eu-central-1)
# DATABASE_URL : chaîne poolée (hôte en -pooler), utilisée par l'application
# DATABASE_URL_UNPOOLED : chaîne directe, utilisée par Prisma migrate et le seed
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH="production"
# Alternative locale (docker compose up -d) : mêmes valeurs pour les deux variables
# DATABASE_URL="postgresql://tacosfox:tacosfox@localhost:5434/tacosfox"
# DATABASE_URL_UNPOOLED="postgresql://tacosfox:tacosfox@localhost:5434/tacosfox"

# Auth.js
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Auth0 (SPA, valeurs publiques). Origines à déclarer dans Auth0 :
# Callback, Logout et Web Origins : http://localhost:3000 et https://tacos-fox.vercel.app
NEXT_PUBLIC_AUTH0_DOMAIN="dev-yswlyfc44okgxe10.us.auth0.com"
NEXT_PUBLIC_AUTH0_CLIENT_ID="t9FyFHXc7OgYX1yGpkJcQLDVOqrQL5hU"

# URL publique du site (sans slash final)
APP_URL="http://localhost:3000"

# Stripe (clés de test en développement)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Resend (e-mails transactionnels)
RESEND_API_KEY=""
EMAIL_FROM="Tacos Fox <commandes@tacosfox.fr>"

# Compte gérant créé par le seed (poste local uniquement, inutile sur Vercel)
SEED_ADMIN_EMAIL="gerant@tacosfox.fr"
SEED_ADMIN_PASSWORD=""

# Auth0 (connexion rapide Google, Apple, Microsoft) : application « Regular Web Application »
# Callback : https://<domaine>/api/auth/callback/auth0 — laisser vide pour désactiver
AUTH_AUTH0_ID=""
AUTH_AUTH0_SECRET=""
AUTH_AUTH0_ISSUER="https://dev-yswlyfc44okgxe10.us.auth0.com"
