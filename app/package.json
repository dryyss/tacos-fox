    "@neon/config": "^1.9.2",
    "@neon/env": "^1.6.3",
    "@prisma/adapter-pg": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "@vercel/functions": "^3.10.1",
    "bcryptjs": "^3.0.3",
    "next": "15.5.19",
    "next-auth": "^5.0.0-beta.32",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
