// Tacos Fox : schéma de données
// Montants en centimes (Int) pour éviter les erreurs d'arrondi.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

/* ---------- Utilisateurs et authentification ---------- */

enum Role {
  CUSTOMER
  STAFF // équipe d'un ou plusieurs restaurants
  ADMIN // gérant Tacos Fox (tous les restaurants)
  SUPERADMIN // MAGAR Développement : tout, options comprises
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  emailVerified  DateTime?
  passwordHash   String?
  name           String?
  phone          String?
  image          String?
  role           Role      @default(CUSTOMER)
  staffRestaurants String[] @default([]) // slugs des restaurants de l'équipier (rôles Auth0 tacosfox:staff:<slug>)
  marketingOptIn Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]
  favorites Favorite[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  label      String
  line1      String
  extra      String?
  postalCode String
  city       String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

/* ---------- Carte ---------- */

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  label       String
  description String?
  sortOrder   Int       @default(0)
  isVisible   Boolean   @default(true)
  products    Product[]
}

enum ProductKind {
  STANDARD
  TACOS
  PIZZA
}

model Product {
  id          String      @id @default(cuid())
  slug        String      @unique
  categoryId  String
  kind        ProductKind @default(STANDARD)
  name        String
  description String      @default("")
  formula     String?
  range       String?
  price       Int // prix de base en centimes (ou plus petite taille)
  priceFrom   Boolean     @default(false)
  badges      String[]    @default([])
  allergens   String[]    @default([])
  imageUrl    String?
  tbc         Boolean     @default(false) // prix à confirmer par le restaurant
  isAvailable Boolean     @default(true) // rupture de stock si false
  isHidden    Boolean     @default(false) // masqué de la carte
  isFeatured  Boolean     @default(false) // incontournable sur l'accueil
  stock       Int? // null = illimité
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id])
  sizes        ProductSize[]
  optionGroups OptionGroup[]
  favorites    Favorite[]
  orderItems   OrderItem[]
  restaurants  Restaurant[]  @relation("ProductRestaurants") // vide = carte commune (tous les restaurants)

  @@index([categoryId])
}

model ProductSize {
  id          String  @id @default(cuid())
  productId   String
  code        String
  label       String
  hint        String?
  price       Int
  includedQty Int     @default(1) // tacos : nombre de viandes autorisées
  bogo        Boolean @default(false) // pizza : 1 achetée = 1 offerte
  sortOrder   Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, code])
}

model OptionGroup {
  id          String  @id @default(cuid())
  productId   String
  key         String
  label       String
  hint        String?
  min         Int     @default(0)
  max         Int     @default(1)
  maxFromSize Boolean @default(false) // le maximum vient de ProductSize.includedQty
  allowRepeat Boolean @default(false) // un même choix peut être pris plusieurs fois
  sortOrder   Int     @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices OptionChoice[]

  @@unique([productId, key])
}

model OptionChoice {
  id          String  @id @default(cuid())
  groupId     String
  label       String
  price       Int     @default(0)
  isAvailable Boolean @default(true)
  sortOrder   Int     @default(0)

  group OptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

/* ---------- Commandes ---------- */

enum OrderMode {
  SURPLACE
  EMPORTER
  LIVRAISON
}

enum OrderStatus {
  PENDING_PAYMENT // paiement carte en attente
  RECEIVED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  ONSITE
}

enum PaymentStatus {
  UNPAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

model Order {
  id                    String        @id @default(cuid())
  number                Int           @unique @default(autoincrement())
  restaurantId          String? // obligatoire pour toute nouvelle commande
  userId                String?
  mode                  OrderMode
  status                OrderStatus   @default(RECEIVED)
  asap                  Boolean       @default(true)
  scheduledFor          DateTime?
  customerName          String
  customerPhone         String
  customerEmail         String
  addressLine1          String?
  addressExtra          String?
  postalCode            String?
  city                  String?
  note                  String?
  subtotal              Int
  deliveryFee           Int           @default(0)
  discount              Int           @default(0)
  total                 Int
  promoCode             String?
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus @default(UNPAID)
  refundedAmount        Int           @default(0)
  stripeSessionId       String?       @unique
  stripePaymentIntentId String?
  invoiceNumber         String?       @unique
  invoicedAt            DateTime?
  trackingToken         String        @unique @default(cuid())
  printedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])
  items  OrderItem[]
  events OrderEvent[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([restaurantId, status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  qty       Int
  unitPrice Int
  details   String[] @default([])
  config    Json // sélection d'origine, pour « recommander »

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderEvent {
  id        String       @id @default(cuid())
  orderId   String
  status    OrderStatus?
  message   String
  createdAt DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/* ---------- Restaurants (formule multi-restaurants) ---------- */

model Restaurant {
  id                   String   @id @default(cuid())
  slug                 String   @unique // ville, pour l'URL de la page locale : /restaurants/stains
  code                 String   @unique // 3 lettres, préfixe des factures : F-STA-2026-00001
  name                 String // « Tacos Fox Stains »
  city                 String
  postalCode           String
  addressLine1         String   @default("")
  phone                String   @default("")
  email                String   @default("")
  intro                String   @default("") // texte de la page locale (référencement)
  isActive             Boolean  @default(true) // visible et commandable
  orderingEnabled      Boolean  @default(true) // interrupteur rush / fermeture exceptionnelle
  prepMinutes          Int      @default(20)
  slotInterval         Int      @default(15)
  tables               Int      @default(0) // nombre de QR codes de table
  legalName            String   @default("") // société qui exploite et encaisse (factures)
  siret                String   @default("")
  vatNumber            String   @default("")
  vatRate              Int      @default(1000) // points de base : 1000 = 10 %
  stripeAccountId      String? // compte Stripe Connect qui reçoit les paiements
  stripeChargesEnabled Boolean  @default(false)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  hours    RestaurantHours[]
  orders   Order[]
  products Product[]         @relation("ProductRestaurants")
}

model RestaurantHours {
  restaurantId String
  dayOfWeek    Int // 0 = lundi ... 6 = dimanche
  isOpen       Boolean @default(true)
  open         String // "11:00"
  close        String // "23:00", "00:00" = minuit

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@id([restaurantId, dayOfWeek])
}

/* ---------- Réglages du restaurant ---------- */

model DeliveryZone {
  id         String  @id @default(cuid())
  city       String
  postalCode String
  fee        Int
  freeFrom   Int? // livraison offerte à partir de ce sous-total
  minimum    Int     @default(0)
  isActive   Boolean @default(true)
  sortOrder  Int     @default(0)

  @@unique([postalCode, city])
}

model OpeningHours {
  dayOfWeek Int     @id // 0 = lundi ... 6 = dimanche
  isOpen    Boolean @default(true)
  open      String // "11:00"
  close     String // "23:00", "00:00" = minuit
}

enum PromoType {
  PERCENT
  FIXED
}

model PromoCode {
  id          String    @id @default(cuid())
  code        String    @unique
  description String?
  type        PromoType
  value       Int // pourcentage (10 = 10 %) ou montant en centimes
  minSubtotal Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?
  maxUses     Int?
  uses        Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
}

/* Visuels publicitaires de l'accueil, gérés depuis la vitrine admin */
enum SlidePlacement {
  CAROUSEL // grand diaporama
  BANNER // bandeau sous le hero
  PANEL // cartes côte à côte
}

enum SlideTone {
  YELLOW
  RED
  DARK
  CREAM
}

model PromoSlide {
  id         String          @id @default(cuid())
  placement  SlidePlacement
  tone       SlideTone       @default(YELLOW)
  kicker     String          @default("")
  title      String
  highlight  String          @default("") // extrait du titre mis en couleur
  text       String          @default("")
  ctaLabel   String          @default("")
  ctaHref    String          @default("/carte")
  imageUrl   String?
  badge      String          @default("") // pastille courte : 2x, XXL, 0 €
  sortOrder  Int             @default(0)
  isActive   Boolean         @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([placement, isActive, sortOrder])
}

// Réglages uniques du restaurant (une seule ligne, id = "main")
model Settings {
  id               String  @id @default("main")
  name             String  @default("TACOS FOX")
  tagline          String  @default("by Paris, since 1998")
  slogan           String  @default("La meilleure excuse pour ne pas cuisiner ce soir")
  halalLabel       String  @default("Viande halal certifiée Achahada")
  phone            String  @default("")
  email            String  @default("")
  addressLine1     String  @default("")
  postalCode       String  @default("93240")
  city             String  @default("Stains")
  legalName        String  @default("")
  siret            String  @default("")
  vatNumber        String  @default("")
  vatRate          Int     @default(1000) // en points de base : 1000 = 10 %
  acceptCard       Boolean @default(true)
  acceptOnsite     Boolean @default(true)
  orderingEnabled  Boolean @default(true)
  modeSurplace     Boolean @default(true)
  modeEmporter     Boolean @default(true)
  modeLivraison    Boolean @default(true)
  prepMinutes      Int     @default(20)
  deliveryMinutes  Int     @default(35)
  slotInterval     Int     @default(15)
  enabledOptions   String[] @default([]) // options du devis activées : O1 (gestion carte), O5 (livraison), O7 (espace client)…
  instagram        String?
  snapchat         String?
  tiktok           String?
  facebook         String?
  updatedAt        DateTime @updatedAt
}

// Compteurs de numérotation (factures)
model Counter {
  key   String @id
  value Int    @default(0)
}

// Photos des produits, stockées en base (le disque Clever Cloud n'est pas persistant)
model Image {
  id        String   @id @default(cuid())
  mime      String
  data      Bytes
  size      Int
  createdAt DateTime @default(now())
}
